# Copy to .env and fill in your values. Never commit .env.

# --- Assets & timeframe ---
ASSETS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h

# Optional: add real stocks (data via yfinance, paper-only). Symbols default to
# "crypto"; mark stocks here. Stocks only trade during US market hours.
# Example:
#   ASSETS=BTC/USDT,ETH/USDT,SOL/USDT,AAPL,MSFT
#   ASSET_CLASSES=AAPL:stock,MSFT:stock
ASSET_CLASSES=

# --- Broker ---
# paper (default, free) | hyperliquid_testnet (optional)
BROKER=paper
PAPER_INITIAL_BALANCE=10000.0
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_BPS=5

# --- LLM providers (free tiers, no billing required) ---
# Comma-separated order: gateway tries left-to-right with fallback
LLM_PROVIDER_ORDER=gemini,groq,openrouter

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Max LLM calls per day across all providers (stay inside free tier)
LLM_DAILY_REQUEST_BUDGET=1400

# --- Database ---
# Neon / Supabase free tier — leave empty to skip persistence in dev
DATABASE_URL=

# --- Risk limits ---
MAX_POSITION_SIZE_PCT=0.10
MAX_TOTAL_EXPOSURE_PCT=0.30
MAX_OPEN_POSITIONS=3
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06
MAX_DAILY_DRAWDOWN_PCT=0.05

# --- Hyperliquid testnet (only if BROKER=hyperliquid_testnet) ---
HL_PRIVATE_KEY=
HL_TESTNET=true
